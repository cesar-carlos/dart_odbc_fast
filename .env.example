# ==============================================================================
# ODBC Test Configuration - EXAMPLE
# ==============================================================================
# Copy this file to .env and adjust the values according to your configuration
# 
# cp .env.example .env  (Linux/Mac)
# copy .env.example .env  (Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# ODBC Connection String (RECOMMENDED)
# ------------------------------------------------------------------------------
# Use ODBC_TEST_DSN to specify the complete connection string.

# SQL Server - localhost
ODBC_TEST_DSN=Driver={SQL Server Native Client 11.0};Server=localhost;Database=YourDatabase;UID=your_user;PWD=your_password;

# ------------------------------------------------------------------------------
# Or use individual variables (SQL Server only)
# ------------------------------------------------------------------------------
# If ODBC_TEST_DSN is not defined, the system will use these:

# SQLSERVER_TEST_SERVER=localhost
# SQLSERVER_TEST_DATABASE=YourDatabase
# SQLSERVER_TEST_USER=your_user
# SQLSERVER_TEST_PASSWORD=your_password
# SQLSERVER_TEST_PORT=1433

# ------------------------------------------------------------------------------
# E2E Test Execution Control (Rust integration tests)
# ------------------------------------------------------------------------------
# Values: "1" (run), "0" (skip), not defined (skip)
# ENABLE_E2E_TESTS=1

# ------------------------------------------------------------------------------
# Live database tests (Dart)
# ------------------------------------------------------------------------------
# "1" / true / yes: enables DSN-dependent live DB tests in test/ that are
# skipped by default (see test/helpers/load_env.dart). Requires ODBC_TEST_DSN.
# RUN_LIVE_TESTS=1

# ------------------------------------------------------------------------------
# Slow / stress tests (Dart + Rust E2E)
# ------------------------------------------------------------------------------
# Dart — "1" / true / yes: runs normally skipped stress tests (pool / isolate /
# streaming, including extreme variants). Requires ODBC_TEST_DSN.
# RUN_SKIPPED_TESTS=1
#
# Rust — "1": includes long-running #[ignore] E2E stress/benchmark suites
# (pool stress, 50k-row streaming, BCP 100k, transaction stress). Used by
# scripts/run_e2e_tests.sh and run_e2e_tests.ps1. RUN_SKIPPED_TESTS is mapped
# to this variable when ENABLE_SLOW_E2E_TESTS is unset.
# ENABLE_SLOW_E2E_TESTS=1

# ------------------------------------------------------------------------------
# Executable Examples Control
# ------------------------------------------------------------------------------
# ODBC_EXAMPLE_ENABLE_BULK controls whether the bulk insert example should run:
#   - "1", "true" or "yes": Runs the bulk insert example
#   - "0", "false" or not defined: Skips the bulk insert example (default)
# 
# ODBC_EXAMPLE_ENABLE_BULK=1

# ------------------------------------------------------------------------------
# Native library (optional — integration test only)
# ------------------------------------------------------------------------------
# Path to the compiled native ODBC engine shared library. When set,
# test/native_assets_test.dart can load via loadOdbcLibraryFromPath.
# ODBC_CUSTOM_LIB_PATH=

# ------------------------------------------------------------------------------
# Examples for Different Databases
# ------------------------------------------------------------------------------

# SQL Server - ODBC Driver 17 or 18 (latest)
# ODBC_TEST_DSN=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=TestDB;UID=your_user;PWD=your_password;TrustServerCertificate=yes;

# SQL Server - localhost with specific port
# ODBC_TEST_DSN=Driver={SQL Server Native Client 11.0};Server=localhost,1433;Database=YourDatabase;UID=your_user;PWD=your_password;

# SQL Server - remote server
# ODBC_TEST_DSN=Driver={SQL Server Native Client 11.0};Server=192.168.1.100,1433;Database=MyDatabase;UID=your_user;PWD=your_password;

# PostgreSQL
# ODBC_TEST_DSN=Driver={PostgreSQL Unicode};Server=localhost;Port=5432;Database=testdb;UID=postgres;PWD=your_password;

# MySQL
# ODBC_TEST_DSN=Driver={MySQL ODBC 8.0 Unicode Driver};Server=localhost;Port=3306;Database=testdb;UID=root;PWD=your_password;

# Oracle
# ODBC_TEST_DSN=Driver={Oracle in OraClient19Home1};DBQ=localhost:1521/ORCL;UID=system;PWD=your_password;

# Sybase Anywhere 16
# ServerName is the SQL Anywhere database server name (not the hostname)
# ODBC_TEST_DSN=Driver={SQL Anywhere 16};Host=localhost;Port=2650;ServerName=YourServerName;DatabaseName=YourDatabase;UID=dba;PWD=your_password;

# ------------------------------------------------------------------------------
# Additional Examples
# ------------------------------------------------------------------------------

# SQL Server - Docker (default password for mcr.microsoft.com/mssql/server container)
# ODBC_TEST_DSN=Driver={ODBC Driver 18 for SQL Server};Server=localhost,1433;Database=master;UID=sa;PWD=YourStrong@Passw0rd;TrustServerCertificate=yes;

# SQL Server - using environment variables (useful for CI/CD)
# ODBC_TEST_DSN=Driver={SQL Server Native Client 11.0};Server=${DB_HOST};Database=${DB_NAME};UID=${DB_USER};PWD=${DB_PASS};
